# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill every value in. `.env` is git-ignored.
# Nothing here is optional unless it says so.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
# Public origin of your site (used for Stripe return URLs + absolute links).
NEXT_PUBLIC_APP_URL=https://coach.example.com
# Keep true: the app runs behind the Caddy reverse proxy.
AUTH_TRUST_HOST=true
# Run the in-process background job worker on this instance (true/false).
RUN_WORKER=true

# ── Database (Postgres) ──────────────────────────────────────────────────────
# Used by the `db` container:
POSTGRES_USER=coach
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=coach
# Used by the app to connect. Host is the compose service name `db`.
# Keep user/password/db in sync with the three values above.
DATABASE_URL=postgres://coach:replace-with-a-long-random-password@db:5432/coach

# ── Auth.js + Discord login ──────────────────────────────────────────────────
# Session signing secret. Generate one:  openssl rand -base64 33
AUTH_SECRET=
# Discord application (https://discord.com/developers/applications) → OAuth2.
# Add this redirect URL there:
#   https://coach.example.com/api/auth/callback/discord
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# ── Stripe (hosted Checkout) ─────────────────────────────────────────────────
# Dashboard → Developers → API keys (secret key).
STRIPE_SECRET_KEY=sk_test_xxx
# Dashboard → Developers → Webhooks → add endpoint
#   https://coach.example.com/api/webhooks/stripe
# then copy its "Signing secret" here.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Discord bot (OPTIONAL until session provisioning is enabled) ──────────────
# Bot token + the server (guild) id where session channels get created.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# ── Deployment / HTTPS (Caddy) ───────────────────────────────────────────────
# The domain that points at this server. Caddy gets HTTPS for it automatically.
DOMAIN=coach.example.com
# Email Let's Encrypt uses for cert notices.
ACME_EMAIL=you@example.com
