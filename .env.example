# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill every value in. `.env` is git-ignored.
# Nothing here is optional unless it says so.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
# Public origin of your site (used for Stripe return URLs + absolute links).
NEXT_PUBLIC_APP_URL=https://coach.example.com
# Default site/brand name (an admin can override this in-app under Settings).
NEXT_PUBLIC_SITE_NAME=GG Coach
# Keep true: the app runs behind the Caddy reverse proxy.
AUTH_TRUST_HOST=true
# Run the in-process background job worker on this instance (true/false).
RUN_WORKER=true
# DEV ONLY: skip Stripe and instantly confirm bookings so you can demo the flow
# without real keys. Ignored entirely when NODE_ENV=production. Leave false.
DEV_BYPASS_PAYMENTS=false

# ── Database (Postgres) ──────────────────────────────────────────────────────
# Used by the `db` container:
POSTGRES_USER=coach
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=coach
# Used by the app to connect. Host is the compose service name `db`.
# Keep user/password/db in sync with the three values above.
DATABASE_URL=postgres://coach:replace-with-a-long-random-password@db:5432/coach

# ── Auth.js + Discord login ──────────────────────────────────────────────────
# Session signing secret. Generate one:  openssl rand -base64 33
AUTH_SECRET=
# Discord application (https://discord.com/developers/applications) → OAuth2.
# Add this redirect URL there:
#   https://coach.example.com/api/auth/callback/discord
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# Comma-separated Discord user ids auto-granted admin on sign-in. Set this to
# YOUR Discord id to bootstrap the first admin of a fresh instance.
ADMIN_DISCORD_IDS=

# ── Stripe (hosted Checkout) ─────────────────────────────────────────────────
# Dashboard → Developers → API keys (secret key).
STRIPE_SECRET_KEY=sk_test_xxx
# Dashboard → Developers → Webhooks → add endpoint
#   https://coach.example.com/api/webhooks/stripe
# then copy its "Signing secret" here.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Discord bot (OPTIONAL — leave blank to run without session channels) ──────
# With these set, the bot provisions a private text channel per booking, lets
# the coach invite the client in early (button), and opens a private voice
# channel when the session starts.
#
# Setup: discord.com/developers → New Application → Bot → copy the token.
# Invite it to your server with the Manage Channels, Manage Roles, Create
# Invite, View Channels, Send Messages permissions (scope: bot). Guild id =
# right-click your server → Copy Server ID (developer mode).
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Optional: a category (channel folder) id to keep session channels under.
DISCORD_SESSIONS_CATEGORY_ID=

# ── Deployment / HTTPS (Caddy) ───────────────────────────────────────────────
# The domain that points at this server. Caddy gets HTTPS for it automatically.
DOMAIN=coach.example.com
# Email Let's Encrypt uses for cert notices.
ACME_EMAIL=you@example.com
